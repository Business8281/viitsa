rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requester is a company_admin (system admin)
    function isCompanyAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_manager'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_staff'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    // Users: authenticated user can read and write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Clinics: authenticated users can read and write clinic documents
    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Doctors sub-collection
      match /doctors/{doctorId} {
        allow read, write: if request.auth != null;
      }
    }

    // Clinic Settings: working hours, slot duration, reminders
    match /clinic_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Subscriptions: clinic plans and billing status
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null;
    }

    // Patient accounts: owning patient can read/write; clinic staff and admin can read
    match /patient_accounts/{accountId} {
      allow read, write: if true;
    }

    // Patients (Clinic-specific): authenticated users can read/write, public can create via QR
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Appointments: authenticated users can read/write, public can create for QR walk-in
    // Public can also update status/date/time when they hold the correct manage_token
    match /appointments/{apptId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null 
        || (resource.data.manage_token != null && resource.data.manage_token == request.resource.data.manage_token);
      allow delete: if request.auth != null;
    }

    // Bills: authenticated users can write, public/patients can read
    match /bills/{billId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Inventory: authenticated users can write, public/patients can read
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // AI sessions: patient or clinic staff access
    match /ai_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Patient clinic links (multi-clinic access and switching)
    match /patient_clinic_links/{linkId} {
      allow read, write: if true;
    }

    // Family health vault: patient family member profiles
    match /family_members/{memberId} {
      allow read, write: if true;
    }

    // System audit logs: append-only, immutable, read restricted
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Consultations: patients and doctors can view consultations
    match /consultations/{consultationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Invoices: clinic and patients can view invoices
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Billing
    match /billing/{billingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read, write: if request.auth != null;
    }

    // Reports
    match /reports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Health Reports
    match /health_reports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Vitals
    match /vitals/{vitalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin Settings: Company admin can read and write
    match /admin_settings/{settingId} {
      allow read: if isCompanyAdmin();
      allow write: if isCompanyAdmin();
    }

    // Password uniqueness registry: allows verifying and claiming unique password hashes
    match /password_registry/{hashId} {
      allow read, write: if true;
    }

    // Usage counters: clinic AI intake, WhatsApp messages, and quota tracking
    match /usage_counters/{counterId} {
      allow read, write: if true;
    }

    // Subscription plans (public catalog read, admin management)
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isCompanyAdmin();
    }

    // Subscription cancellations
    match /subscription_cancellations/{cancelId} {
      allow read, write: if request.auth != null;
    }

    // AI Conversations
    match /ai_conversations/{convId} {
      allow read, write: if true;
    }

    // Patient reward points
    match /patient_reward_points/{pointId} {
      allow read, write: if true;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
